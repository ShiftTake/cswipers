rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.admin == true ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
      );
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function clubMemberPath(clubId, uid) {
      return /databases/$(database)/documents/clubs/$(clubId)/members/$(uid);
    }

    function clubBanPath(clubId, uid) {
      return /databases/$(database)/documents/clubs/$(clubId)/bans/$(uid);
    }

    function isClubMember(clubId) {
      return signedIn() && exists(clubMemberPath(clubId, request.auth.uid));
    }

    function isClubBanned(clubId) {
      return signedIn() && exists(clubBanPath(clubId, request.auth.uid));
    }

    function isClubOwner(clubId) {
      return signedIn() && exists(clubMemberPath(clubId, request.auth.uid)) &&
        get(clubMemberPath(clubId, request.auth.uid)).data.role == 'owner';
    }

    function isClubModerator(clubId) {
      return isAdmin() || (
        signedIn() &&
        exists(clubMemberPath(clubId, request.auth.uid)) &&
        get(clubMemberPath(clubId, request.auth.uid)).data.role in ['owner', 'agent']
      );
    }

    match /users/{userId} {
      allow create: if isSelf(userId);
      allow read: if isSelf(userId) || isAdmin();
      allow update: if isSelf(userId) &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.status == resource.data.status;
      allow delete: if false;
    }

    match /adminLogs/{logId} {
      allow read, write: if false;
    }

    match /cards/{cardId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if signedIn() &&
        resource.data.ownerUid == request.auth.uid &&
        request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /purchaseIntents/{purchaseId} {
      allow read: if isAdmin() || (signedIn() && (
        resource.data.buyerUid == request.auth.uid ||
        resource.data.sellerUid == request.auth.uid
      ));
      allow create: if signedIn() && request.resource.data.buyerUid == request.auth.uid;
      allow update: if isAdmin() || (signedIn() && (
        resource.data.buyerUid == request.auth.uid ||
        resource.data.sellerUid == request.auth.uid
      ));
      allow delete: if isAdmin();
    }

    match /drafts/{draftId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow update: if signedIn() && resource.data.userId == request.auth.uid;
      allow create, delete: if false;
    }

    match /subscriptions/{subscriptionId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /sellerVerifications/{verificationId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /offers/{offerId} {
      allow read: if isAdmin() || (signedIn() && (
        resource.data.fromUserId == request.auth.uid ||
        resource.data.toUserId == request.auth.uid
      ));
      allow create, update, delete: if false;

      match /messages/{messageId} {
        allow read: if isAdmin() || (signedIn() && (
          get(/databases/$(database)/documents/offers/$(offerId)).data.buyerUid == request.auth.uid ||
          get(/databases/$(database)/documents/offers/$(offerId)).data.sellerUid == request.auth.uid
        ));
        allow create: if signedIn() &&
          request.resource.data.fromUserId == request.auth.uid &&
          request.resource.data.text.size() <= 1000 &&
          (
            get(/databases/$(database)/documents/offers/$(offerId)).data.buyerUid == request.auth.uid ||
            get(/databases/$(database)/documents/offers/$(offerId)).data.sellerUid == request.auth.uid
          );
        allow update, delete: if false;
      }
    }

    match /reviews/{reviewId} {
      allow read: if signedIn();
      allow create: if signedIn() &&
        request.resource.data.reviewerUid == request.auth.uid &&
        !exists(/databases/$(database)/documents/reviews/$(reviewId));
      allow update, delete: if false;
    }

    match /swipes/{swipeId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /interests/{interestId} {
      allow read: if signedIn() && (
        resource.data.fromUserId == request.auth.uid ||
        resource.data.toUserId == request.auth.uid ||
        isAdmin()
      );
      allow create: if signedIn() && request.resource.data.fromUserId == request.auth.uid;
      allow update: if isAdmin() || (signedIn() && (
        resource.data.fromUserId == request.auth.uid ||
        resource.data.toUserId == request.auth.uid
      ));
      allow delete: if false;
    }

    match /matches/{matchId} {
      allow read: if signedIn() && (request.auth.uid in resource.data.participants || isAdmin());
      allow create: if signedIn() && (
        request.auth.uid in request.resource.data.participants ||
        isAdmin()
      );
      allow update, delete: if isAdmin() || (signedIn() && request.auth.uid in resource.data.participants);
    }

    match /messages/{messageId} {
      allow read: if signedIn() && (
        isAdmin() ||
        request.auth.uid in get(/databases/$(database)/documents/matches/$(resource.data.matchId)).data.participants
      );

      allow create: if signedIn() &&
        request.resource.data.fromUserId == request.auth.uid &&
        request.resource.data.text.size() <= 1000 &&
        (
          isAdmin() ||
          request.auth.uid in get(/databases/$(database)/documents/matches/$(request.resource.data.matchId)).data.participants
        );

      allow update, delete: if false;
    }

    match /chatReports/{reportId} {
      allow read: if isAdmin() || (signedIn() && resource.data.reportedByUid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.reportedByUid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /clubs/{clubId} {
      allow read: if isAdmin() || (signedIn() && !isClubBanned(clubId));
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isAdmin() || (
        isClubOwner(clubId) &&
        request.resource.data.ownerUid == resource.data.ownerUid &&
        request.resource.data.get('ownerId', null) == resource.data.get('ownerId', null)
      );
      allow delete: if isAdmin() || isClubOwner(clubId);

      match /joinRequests/{requestId} {
        allow create: if signedIn() &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.status == 'pending';
        allow read, update, delete: if isAdmin() || isClubModerator(clubId);
      }

      match /messages/{messageId} {
        allow read: if isAdmin() || (
          signedIn() &&
          exists(clubMemberPath(clubId, request.auth.uid)) &&
          get(clubMemberPath(clubId, request.auth.uid)).data.status == 'active' &&
          !isClubBanned(clubId)
        );
        allow create: if signedIn() &&
          exists(clubMemberPath(clubId, request.auth.uid)) &&
          get(clubMemberPath(clubId, request.auth.uid)).data.status == 'active' &&
          !isClubBanned(clubId) &&
          request.resource.data.fromUserId == request.auth.uid &&
          request.resource.data.text.size() <= 1000;
        allow update, delete: if false;
      }

      match /members/{memberId} {
        allow read: if isAdmin() || (signedIn() && !isClubBanned(clubId));
        allow create: if isAdmin() || (
          signedIn() &&
          memberId == request.auth.uid &&
          !isClubBanned(clubId) &&
          request.resource.data.uid == request.auth.uid
        ) || (
          isClubModerator(clubId) &&
          request.resource.data.uid == memberId &&
          request.resource.data.role == 'member'
        );
        allow update: if isAdmin() || isClubOwner(clubId);
        allow delete: if isAdmin() || isClubModerator(clubId) || (signedIn() && memberId == request.auth.uid);
      }

      match /events/{eventId} {
        allow read: if isAdmin() || (isClubMember(clubId) && !isClubBanned(clubId));
        allow create: if isClubModerator(clubId) &&
          request.resource.data.createdByUid == request.auth.uid;
        allow update, delete: if isAdmin() || isClubModerator(clubId);

        match /registrations/{memberId} {
          allow read: if isAdmin() || isClubModerator(clubId) ||
            (isClubMember(clubId) && memberId == request.auth.uid);
          allow write: if false;
        }
      }

      match /posts/{postId} {
        allow read: if isAdmin() || (isClubMember(clubId) && !isClubBanned(clubId));
        allow create: if signedIn() &&
          !isClubBanned(clubId) &&
          isClubMember(clubId) &&
          request.resource.data.createdByUid == request.auth.uid;
        allow update, delete: if isAdmin() || isClubModerator(clubId) || (signedIn() && resource.data.createdByUid == request.auth.uid);
      }

      match /reports/{reportId} {
        allow read: if isAdmin() || isClubMember(clubId);
        allow create: if signedIn() &&
          !isClubBanned(clubId) &&
          isClubMember(clubId) &&
          request.resource.data.reportedByUid == request.auth.uid;
        allow update, delete: if isAdmin() || isClubModerator(clubId);
      }

      match /bans/{memberId} {
        allow read: if isAdmin() || isClubModerator(clubId) || (signedIn() && request.auth.uid == memberId);
        allow create, update, delete: if isAdmin() || isClubModerator(clubId);
      }
    }

    match /flaggedCards/{flagId} {
      allow read: if isAdmin();
      allow create: if signedIn() && request.resource.data.flaggedByUid == request.auth.uid;
      allow update, delete: if isAdmin();
    }
  }
}
